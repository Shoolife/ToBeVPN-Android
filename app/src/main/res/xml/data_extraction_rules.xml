<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) — backup / device-transfer rules.

    Same intent as backup_rules.xml: only the encrypted Room database is
    excluded. tobevpn_prefs.preferences_pb is *included* so non-sensitive
    settings (filter mode, language, selected server id, etc.) ride along
    in cloud backup and device-transfer flows. Secrets (auth tokens,
    subscription URL, email) live inside the encrypted database.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="tobevpn.db" />
        <exclude domain="database" path="tobevpn.db-shm" />
        <exclude domain="database" path="tobevpn.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="tobevpn.db" />
        <exclude domain="database" path="tobevpn.db-shm" />
        <exclude domain="database" path="tobevpn.db-wal" />
    </device-transfer>
</data-extraction-rules>
