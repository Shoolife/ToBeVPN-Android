<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Matches setDestinationInExternalFilesDir(context, DIRECTORY_DOWNLOADS, ...) -->
    <external-files-path name="updates" path="Download/" />
    <!-- Fallback: emulators / devices without shared storage land here. -->
    <files-path name="updates_internal" path="updates/" />
    <!-- User-initiated export of locally retained diagnostic journals. -->
    <files-path name="diagnostic_logs" path="diagnostic_logs/" />
    <!-- One-time QR image explicitly shared from the device-pairing screen. -->
    <cache-path name="shared_auth_qr" path="shared_qr/" />
</paths>
