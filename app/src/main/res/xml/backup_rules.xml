<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below (API < 31).
    Exclude Room DB and DataStore containing auth tokens and session data.
-->
<full-backup-content>
    <exclude domain="database" path="tobevpn.db" />
    <exclude domain="database" path="tobevpn.db-shm" />
    <exclude domain="database" path="tobevpn.db-wal" />
    <exclude domain="file" path="datastore/tobevpn_prefs.preferences_pb" />
</full-backup-content>
