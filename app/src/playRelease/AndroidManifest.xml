<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play distributes application updates itself. The Play build
         must not request permission to install APKs from GitHub. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- These package queries only support the direct-download APK updater. -->
    <queries tools:node="remove" />

    <!-- Keep the app's non-exported FileProvider. The Play-specific paths XML
         exposes only a diagnostic log explicitly selected by the user. -->
</manifest>
